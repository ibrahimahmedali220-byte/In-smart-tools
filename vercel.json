{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!sitemap\\.xml|robots\\.txt|llms\\.txt|ai-catalog\\.json|manifest\\.json|favicon\\.svg|og-image\\.svg|icon-192\\.png|icon-512\\.png|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(index\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(sw\\.js|workbox-(.*)\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(manifest\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt|ai-catalog\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ]
}
