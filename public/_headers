# Caching rules for static hosting

# Immutable versioned assets (Vite hashed bundles)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker and HTML must revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Static metadata
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/ai-catalog.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
